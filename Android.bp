// Android 17 Soong packaging for the x86 firmware collection.
//
// Base: android-generic/device_generic_firmware @ e814345a (fork of
// kernel.org linux-firmware; the manifest-pinned BlissOS revision
// main). The fork ships no Android build file - BlissOS consumes
// this repo by running copy-firmware.sh from the kernel/initrd - so
// this Android.bp is a KhillOS addition with no BlissOS equivalent.
//
// Scope is exactly the WHENCE install set (File:/RawFile:/Link:),
// i.e. what copy-firmware.sh installs: each top-level directory is
// one prebuilt_firmware module with per-file srcs/dsts preserving
// relative paths, installed by soc_specific: true to
// /vendor/firmware/<path> - the directory request_firmware() looks
// in (the KhillOS kernel adds /vendor/firmware to the fw_path list,
// mirroring the BlissOS kernel firmware_loader mod). WHENCE Link:
// aliases become install_symlink modules (targets resolved against
// the link's directory, as copy-firmware.sh does) attached via
// `required` - the AOSP external/linux-firmware convention.
//
// Licensing is per WHENCE: every module's `licenses` names the
// license module(s) holding the LICENCE.*/LICENSE.* text WHENCE
// cites for its files. There is no blanket license - the root LICENSE
// says "VARIOUS - Individual firmware binaries are released under
// licenses described in WHENCE". Kinds: BSD-Binary-Only for
// redistributable binary blobs (as AOSP external/linux-firmware
// uses), SPDX kinds for explicit GPL/MIT/dual entries, and
// legacy_notice for "Unknown"/"Allegedly" entries, whose terms the
// WHENCE section itself documents.
//
// Generated by gen-androidbp.py, kept under
// KHILLOS_NOTES/device_generic_firmware/evidence/ (never committed);
// do not edit by hand.

package {
    default_applicable_licenses: ["device_generic_firmware_notice"],
}

// Notice-level fallback covering the WHENCE-attributed "Unknown"/
// "Allegedly" entries and the install_symlink aliases (which carry
// no content of their own; their targets' licenses are recorded by
// the prebuilt_firmware module that ships the target file).
license {
    name: "device_generic_firmware_notice",
    license_kinds: ["legacy_notice"],
    license_text: ["WHENCE"],
}

prebuilt_firmware {
    name: "firmware_3com",
    licenses: ["device_generic_firmware_typhoon_license"],
    srcs: [
        "3com/typhoon.bin",
    ],
    dsts: [
        "3com/typhoon.bin",
    ],
    soc_specific: true,
}

